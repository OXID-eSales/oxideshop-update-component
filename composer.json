{
  "name": "oxid-esales/oxideshop-update-component",
  "description": "Component used to upgrade shop through minor/major versions.",
  "license": [
    "proprietary"
  ],
  "type": "oxideshop-component",
  "homepage": "https://www.oxid-esales.com",
  "require": {
    "php": "^8.2",
    "rector/rector": "^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.4"
  },
  "extra": {
    "oxideshop": {
      "target-directory": "oxideshop-update-component",
      "source-directory": "src",
      "services-yaml": "services.yaml"
    }
  },
  "autoload": {
    "psr-4": {
      "OxidEsales\\OxidEshopUpdateComponent\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "OxidEsales\\OxidEshopUpdateComponent\\Tests\\": "tests"
    }
  }
}
