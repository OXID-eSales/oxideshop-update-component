<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body>

<p>Current date and time: {{ "now"|date_format("%Y-%m-%d %H:%M:%S") }}</p>

<p>Day of the week: {{ "now"|date_format("%A") }}</p>

<p>Month name: {{ "now"|date_format("%B") }}</p>

<p>Full date: {{ "2025-01-13"|date_format("%A, %B %e, %Y") }}</p>

<p>Short date: {{ "2025-01-13"|date_format("%m/%d/%Y") }}</p>

<p>Time (24-hour format): {{ "2025-01-13 14:30"|date_format("%H:%M") }}</p>

</body>
</html>